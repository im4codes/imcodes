# ── Required ──────────────────────────────────────────────────────────────────
DOMAIN=imc.example.com
POSTGRES_PASSWORD=change_me_random_string
JWT_SIGNING_KEY=change_me_64_hex_chars

# ── Optional ─────────────────────────────────────────────────────────────────
# DEFAULT_ADMIN_PASSWORD=          # auto-generated if not set, shown in logs on first run
# WEBAUTHN_RP_ID=example.com       # defaults to DOMAIN; set to parent domain to share passkeys across subdomains

# GitHub OAuth (enables "Sign in with GitHub" on the login page)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Generate secrets with:
#   openssl rand -hex 32

# Optional: other public https origins of this deployment for controlled-node fallback, comma separated
# (e.g. a proxy domain). Nodes send their credential to every listed origin they connect to: each must reach this same server,
# with WebSocket upgrades and ?serverId= routing intact.
# IMCODES_PUBLIC_URLS=https://proxy.example.com

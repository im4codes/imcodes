# Everything fetched or built by scripts/: upstream checkouts, model weights
# (symlinks or copies), Python venv, native build trees, xcframeworks, APK libs.
.cache/

# Never commit model weights, wherever they end up.
*.gguf
*.gguf.part

# Generated by `xcodegen` from ios/project.yml.
ios/R2T2Harness.xcodeproj/
ios/build/

# Host CMake build (scripts/build-host.sh uses .cache/build-host, this is for ad-hoc builds).
build/

__pycache__/
*.pyc
.DS_Store

# Pinned inputs for the R2T2 mobile feasibility spike. Every script reads this.

# llama.cpp: the exact commit upstream r2t2_llama ships binaries for.
LLAMA_CPP_REPO=https://github.com/ggml-org/llama.cpp
LLAMA_CPP_TAG=b10950
LLAMA_CPP_COMMIT=ad6c66839af3c5646fba8c6c2e2087a1e4e38948
# Official release iOS/macOS/tvOS/visionOS xcframework for that tag (includes mtmd).
LLAMA_XCFRAMEWORK_URL=https://github.com/ggml-org/llama.cpp/releases/download/b10950/llama-b10950-xcframework.zip
LLAMA_XCFRAMEWORK_SHA256=13bc0b9a26f52f993101d974e2c23f1f494080714c76fa22fb10d2e4824a27c3

# Upstream R2T2 code (Apache-2.0): streaming algorithm + r2t2_llama backend.
R2T2_REPO=https://github.com/netease-youdao/Confucius4-R2T2
R2T2_COMMIT=26d55a54ce5670cff9947a167d8ed95d569fd4d9

# Weights (NetEase Youdao Model Use License Agreement) - never committed.
R2T2_GGUF_REPO=netease-youdao/Confucius4-R2T2-GGUF
R2T2_GGUF_REVISION=86ff0251cb9f456b63aeef5f80137f104e22869a
R2T2_MODEL_FILE=Confucius4-R2T2-Q4_K_M.gguf
R2T2_MODEL_SHA256=fa3cb46c8c3a66a58812b9098ba6e96a0266d4e8c9b3cf5ba34432fd2f9f6466
R2T2_MODEL_SIZE=1107404736
R2T2_MMPROJ_FILE=mmproj-Confucius4-R2T2-Q8_0.gguf
R2T2_MMPROJ_SHA256=8dc2c67e6a0484114928142d098db7ad94ae9f34c78948ef9d37a9678418cb65
R2T2_MMPROJ_SIZE=348336544

# HF processor files (tokenizer/config only, no weights) - reference run only.
R2T2_HF_REPO=netease-youdao/Confucius4-R2T2
R2T2_HF_REVISION=185ce639118ad1362d049ca0d8ed04b6ec5cd6c9

# qwen-asr Python package used by the upstream streaming code (reference run only).
QWEN_ASR_VERSION=0.0.6

# Android toolchain
ANDROID_NDK_VERSION=27.2.12479018
ANDROID_CMAKE_VERSION=3.22.1
ANDROID_PLATFORM=android-28

# KleidiAI (ggml-cpu Arm kernels), exactly what pinned llama.cpp FetchContent wants.
# Pre-fetched so the NDK/Gradle CMake (3.22, whose curl fails TLS behind some
# proxies) and offline builds never download at configure time.
KLEIDIAI_TAG=v1.24.0
KLEIDIAI_URL=https://github.com/ARM-software/kleidiai/releases/download/v1.24.0/kleidiai-v1.24.0-src.tar.gz
KLEIDIAI_MD5=2f02ebe29573d45813e671eb304f2a00

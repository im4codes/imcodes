#include <windows.h>

// Resource 1: the application icon (built from the official IM.codes logo by scripts/aidesk-icon.mjs).
1 ICON "@AIDESK_ICON_FOR_RC@"
// The manifest: asInvoker, per-monitor DPI v2. Embedded here for every toolchain, so the linker must not add its own.
1 RT_MANIFEST "@AIDESK_MANIFEST_FOR_RC@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "IM.codes"
      VALUE "FileDescription", "aiDesk.to by IM.codes"
      VALUE "InternalName", "aidesk-local-ui"
      VALUE "OriginalFilename", "aidesk-local-ui.exe"
      VALUE "ProductName", "aiDesk.to by IM.codes"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

# This target intentionally depends on the pinned checkout's root WebRTC
# target. Apple frameworks provide capture and H.264 only; libwebrtc remains
# the sole implementation of ICE, DTLS-SRTP, RTP/RTCP, pacing and congestion
# control.
rtc_executable("imcodes_macos_remote_desktop_build_spike") {
  testonly = true
  sources = [ "build_spike.mm" ]

  # Make the macOS 12.3 deployment target an API-availability gate rather than
  # accepting a warning for a newer unguarded SDK symbol.
  cflags_objcc = [ "-Werror=unguarded-availability-new" ]

  deps = [ "//:webrtc" ]

  frameworks = [
    "CoreMedia.framework",
    "CoreVideo.framework",
    "Foundation.framework",
    "ScreenCaptureKit.framework",
    "VideoToolbox.framework",
  ]
}

